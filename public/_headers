# Security headers for every response (Cloudflare Pages). Ported from the old nginx.conf.
/*
  Content-Security-Policy: default-src 'none'; base-uri 'self'; form-action 'none'; manifest-src 'self'; script-src 'self' https://asciinema.org __INLINE_SCRIPT_HASHES__ __INLINE_HANDLER_HASHES__; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://w.soundcloud.com https://embed.spotify.com https://open.spotify.com https://asciinema.org; media-src 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests; report-uri https://sqroot.report-uri.com/r/d/csp/enforce
  Permissions-Policy: accelerometer=(), battery=(), camera=(), microphone=(), payment=(), geolocation=(), usb=()
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  X-Want-To-Work-With: Cyber Security & HTTP API-s
  X-Recruitment: https://linkedin.com/in/anroots
  X-Powered-By: Nuxt

# Hashed build assets never change: cache them for a year
/_nuxt/*
  Cache-Control: public, max-age=31536000, immutable

# Generated responsive image variants are content-addressed as well
/_ipx/*
  Cache-Control: public, max-age=31536000, immutable

# Images and other embedded content may be hot-linked from feeds and social cards
/content/*
  Cross-Origin-Resource-Policy: cross-origin
  Cache-Control: public, max-age=604800
