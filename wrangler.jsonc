{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sqroot-eu",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": ".output/public",
    // Nuxt prerenders /not-found and postbuild.mjs copies it to 404.html.
    // Without this, unmatched paths get a bodyless 404 instead of the real page.
    "not_found_handling": "404-page",
    // autoSubfolderIndex: false means Nuxt emits about.html, not about/index.html.
    // This serves /about from it and redirects /about/ -> /about, like Pages did.
    "html_handling": "auto-trailing-slash"
  }
}
